{
  "name": "tvctl-agent",
  "version": "0.1.0",
  "description": "An always-listening voice agent that controls tvctl, with OptChat memory on pi-durable",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "build:voice": "cd voice && swift build -c release"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "proper-lockfile": "4.1.2",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^7.0.2"
  }
}
